          }
        },
        "eventColor": {
          "displayName": "Marker colour",
          "displayNameKey": "Annotations_EventColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "noteFontFamily": {
          "displayName": "Font family",
          "displayNameKey": "Annotations_FontFamily",
          "type": {
            "formatting": {
              "fontFamily": true
            }
          }
        },
        "noteFontSize": {
          "displayName": "Font size",
          "displayNameKey": "Annotations_FontSize",
