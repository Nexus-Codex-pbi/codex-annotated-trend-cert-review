            "formatting": {
              "fontSize": true
            }
          }
        },
        "noteBold": {
          "displayName": "Bold",
          "displayNameKey": "Annotations_Bold",
          "type": {
            "bool": true
          }
        },
        "noteItalic": {
          "displayName": "Italic",
          "displayNameKey": "Annotations_Italic",
          "type": {
            "bool": true
          }
        },
        "noteColor": {
          "displayName": "Note text colour",
          "displayNameKey": "Annotations_NoteColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "showDate": {
          "displayName": "Show date in note",
          "displayNameKey": "Annotations_ShowDate",
          "type": {
            "bool": true
          }
        },
        "keep": {
          "displayName": "When notes don't fit, keep",
          "displayNameKey": "Annotations_Keep",
          "type": {
            "enumeration": [
              {
                "displayName": "Latest first",
                "displayNameKey": "Keep_Latest",
                "value": "latest"
              },
              {
                "displayName": "Earliest first",
                "displayNameKey": "Keep_Earliest",
                "value": "earliest"
              },
              {
                "displayName": "Largest value first",
                "displayNameKey": "Keep_Largest",
                "value": "largest"
              }
            ]
          }
        },
        "maxNotes": {
          "displayName": "Maximum notes (0 = as many as fit)",
          "displayNameKey": "Annotations_MaxNotes",
          "type": {
            "numeric": true
          }
        },
        "labelDensity": {
          "displayName": "Label density",
          "displayNameKey": "Annotations_LabelDensity",
          "description": "How many notes to try to place, as a percentage. 100 places every note that fits without overlapping anything; 0 places only the most important note. Notes left out are counted in \"+N more notes\".",
          "descriptionKey": "Annotations_LabelDensity_Description",
          "type": {
            "numeric": true
          }
        }
      }
    },
