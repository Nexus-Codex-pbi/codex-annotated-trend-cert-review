{
  "dataRoles": [
    {
      "name": "axis",
      "displayName": "Axis",
      "displayNameKey": "Role_Axis",
      "kind": "Grouping",
      "description": "Date or ordered category, one point per row (e.g. Date[Date] or Date[Month])",
      "descriptionKey": "Role_Axis_Desc"
    },
    {
      "name": "values",
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "kind": "Measure",
      "description": "The trend measure (e.g. Daily releases)",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "name": "eventNote",
      "displayName": "Event note",
      "displayNameKey": "Role_EventNote",
      "kind": "Measure",
      "description": "Text measure, blank on rows without an event, e.g. CONCATENATEX(VALUES(Events[Note]), Events[Note], \" · \")",
      "descriptionKey": "Role_EventNote_Desc"
    },
    {
      "name": "eventType",
      "displayName": "Event type",
      "displayNameKey": "Role_EventType",
      "kind": "Measure",
      "description": "Optional text measure (e.g. Launch, Outage, Price change), shown in the tooltip",
      "descriptionKey": "Role_EventType_Desc"
    },
    {
      "name": "eventPriority",
      "displayName": "Note priority",
      "displayNameKey": "Role_EventPriority",
      "kind": "Measure",
      "description": "Optional number: when notes do not all fit, higher priority keeps its note first",
      "descriptionKey": "Role_EventPriority_Desc"
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the hover tooltip",
      "descriptionKey": "Role_Tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "axis": {
            "max": 1
          },
          "values": {
            "max": 1
          },
          "eventNote": {
            "max": 1
          },
          "eventType": {
            "max": 1
          },
          "eventPriority": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "axis"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "eventNote"
              }
            },
            {
              "for": {
                "in": "eventType"
              }
            },
            {
              "for": {
                "in": "eventPriority"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "annotations": {
      "displayName": "Event notes",
      "displayNameKey": "Annotations_Card",
      "properties": {
        "style": {
          "displayName": "Note style",
          "displayNameKey": "Annotations_Style",
          "type": {
            "enumeration": [
              {
                "displayName": "Leader-line labels",
                "displayNameKey": "Style_Leader",
                "value": "leader"
              },
              {
                "displayName": "Callout cards",
                "displayNameKey": "Style_Callout",
                "value": "callout"
              },
              {
                "displayName": "Numbered pins",
